	file = {Hamann et al (2005) - ecotype proxies population.pdf:C\:\\Users\\jing007\\OneDrive - UBC\\Research Project\\paper 2 ecosystem niche\\ref candidates\\Hamann et al (2005) - ecotype proxies population.pdf:application/pdf},
