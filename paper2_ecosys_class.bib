@article{rao_biodiversity_2013,
	title = {Biodiversity {Conservation} in a {Changing} {Climate}: {A} {Review} of {Threats} and {Implications} for {Conservation} {Planning} in {Myanmar}},
	volume = {42},
	copyright = {http://www.springer.com/tdm},
